module GPIO_Controller #(parameter GPIO = 100)
(
    input clk,
    input [31:0] addr,
    input [31:0] data_in, 
    output reg  [31:0] data_out,
    input wire wr_en,
    input wire rd_en, 
    output reg [GPIO - 1:0] gpio_pins


);

reg [31:0] gpio_data;   //Used for storing the data to be read or to be written 
reg [15:0] gpio_dir;    //Used to define whether gpio pin is used for input or output


//Address Mapping 
localparam gpio_data = 32'h80000000;
localparam gpio_dir =  32'h80000004;

always @(posedge clk) begin
    gpio_data <= 16'h0000;  
    gpio_dir <=  16'h0000;
    data_out <=  32'h00000000;
end else begin 
    if(wr_en) begin 
        if(addr == gpio_data) begin
            gpio_data <= data_in[15:0];
        end else if (addr == gpio_dir) begin 
            gpio_dir <= data_in[15:0]
        end 
        end 
    end 

    if(rd_en) begin 
        if(addr == gpio_data) begin                      
            data_out <= {16'h0000, gpio_data};
        end else if (addr == gpio_dir) begin 
            data_out <= {16'h0000, gpio_dir};
        end else begin 
            data_out <=  32'h00000000;
        end 
    end 

always@(*) begin 
    for (int i = 0; i < 16; i = i + 1) begin
        
        if (gpio_dir[i]) begin
            gpio[i] = gpio_data[i];  // Output mode
        
        end else begin
            gpio[i] = 1'bz;          // Input mode (high impedance)
        end
    end
end  
endmodule 
